{
  "name": "oarnova-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official website of OAR NOVA GAMES STUDIO (static, bilingual EN/FA).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate && node scripts/postbuild.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:dist": "node scripts/check-dist.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "artifact": "node scripts/artifact.mjs",
    "postinstall": "nuxt prepare",
    "build:fonts": "node scripts/build-fonts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "gsap": "3.15.0",
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
